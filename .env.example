# Copy to .env for local dev. On Railway, set these as service variables.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Railway auto-provides DATABASE_URL when you add Postgres.
# DATABASE_URL=postgresql://...
# Path to the mounted Railway volume so uploads survive redeploys.
MEDIA_ROOT=/data/media
# AI organizer (OpenRouter). Leave AI_API_KEY blank to disable AI processing.
AI_API_BASE=https://openrouter.ai/api/v1
AI_API_KEY=
# Confirmed-free model. Do NOT set a paid slug without Jay's approval.
AI_MODEL=mistralai/mistral-7b-instruct:free
