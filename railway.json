{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "mkdir -p ${MEDIA_ROOT:-/data/media} && gunicorn config.wsgi --log-file - --bind 0.0.0.0:${PORT:-8000}",
    "preDeployCommand": "python manage.py migrate --noinput && python manage.py collectstatic --noinput && python manage.py seed_goins",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
